# App name in page titles and the UI. Defaults to Web App. It is fixed at build time, so rebuild after changing it.
NEXT_PUBLIC_APP_NAME=

# Supabase project (find these under project settings > API).
# https://app.supabase.com/project/_/settings/api
# Leave empty to disable the Supabase integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Prisma (Supabase PostgreSQL). Leave both empty to run without a database. Find the values under project settings >
# Database > Connect:
# - DATABASE_URL, the app runtime: Supavisor transaction pooler (6543), recommended for serverless hosts, such as
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# - DIRECT_URL, the Prisma CLI (migrate and others): session pooler (5432), the same address with port 5432. The direct
#   host (db.<ref>.supabase.co) is IPv6 only.
DATABASE_URL=
DIRECT_URL=
# For the local development database (docker-compose.yaml, `pnpm docker:db`), set the two values above to these
# (for `pnpm dev` on the host). The app container (`pnpm docker:up`) uses DATABASE_URL unchanged, so it needs an
# address other than localhost.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app

# Whether the /design-system showcase is public. 1 opens it. Left empty, production builds answer 404, while the
# development server (pnpm dev) always opens it. It is fixed at build time, so rebuild after changing it.
NEXT_PUBLIC_DESIGN_SYSTEM=

# Server log fields (lib/server/logger.ts). SERVICE_NAME defaults to name in package.json; APP_ENV (for example
# production, staging) defaults to NODE_ENV.
SERVICE_NAME=
APP_ENV=

# Server notifications (lib/notify): incoming webhook URL of the Slack channel that receives them. A secret, since
# anyone holding it can post to the channel. Leave empty to skip notifications.
NOTIFY_SLACK_WEBHOOK_URL=

# Sentry error reporting (find it under project settings > Client Keys (DSN)).
# Leave empty to disable Sentry; errors then go only to the server log.
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload during the build (set only in the build environment; runtime code never reads them).
# Leave empty to skip the upload. Create the token under organization settings > Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
