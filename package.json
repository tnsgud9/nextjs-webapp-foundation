{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docker:db": "docker compose up -d --wait db",
    "docker:up": "docker compose up -d --build --wait app",
    "docker:down": "docker compose --profile app down",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:vitest && pnpm test:playwright",
    "test:vitest": "vitest run",
    "test:vitest:unit": "vitest run --project unit",
    "test:db:up": "docker compose -f docker-compose.test.yaml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yaml down",
    "test:playwright": "playwright test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nextjs": "11.9.0",
    "@shadcn/react": "^0.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "ky": "^2.2.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.0",
  "engines": {
    "node": "26.x"
  }
}
