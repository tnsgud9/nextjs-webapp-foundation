# Environment of every test (pnpm test): Vitest gives it to each test, and Playwright to the app server it builds and
# starts (test-utils/shared/test-env.ts).
# Committed, so it holds no secrets and never a real service's address. It lists every variable in .env.example, so
# .env never fills one in; an empty value means unset. test-utils/shared/test-env.vitest.test.ts checks both.
# Next.js also loads this file when NODE_ENV is test.

NEXT_PUBLIC_APP_NAME=Test App

# Filled in by Playwright with the fake Auth server (test-utils/playwright/supabase-auth.ts); Vitest tests that need
# Supabase start their own.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The test Postgres and Redis (docker-compose.test.yaml, `pnpm test:db:up`; CI starts the same at these addresses).
# Tests empty them, so they must stay on localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/app_test
DATABASE_POOL_MAX=
REDIS_URL=redis://localhost:6380

NEXT_PUBLIC_DESIGN_SYSTEM=
SERVICE_NAME=
APP_ENV=

# Off: no notification leaves the tests.
NOTIFY_SLACK_WEBHOOK_URL=

# An address nothing listens on; tests intercept the browser's requests instead.
NEXT_PUBLIC_SENTRY_DSN=http://public@localhost:9/1
# Off: test builds upload no source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

NEXT_DEPLOYMENT_ID=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
